@startuml c4-nivel3-componentes-inscripciones
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Nivel 3 - Componentes del módulo de Inscripciones y control de cupos (API PIA)

Container(proxy, "Proxy inverso", "Nginx", "TLS, balanceo, limitación de tasa")
Container(sync, "Sincronizador", "Java / Spring Boot", "Despacha la outbox al legado y devuelve el resultado")
ContainerDb(db, "Base de datos PIA", "PostgreSQL 16", "Esquemas inscripcion, oferta, historial, reglas, auditoria, integracion")

Container_Boundary(api, "API PIA - Módulo Inscripciones y cupos") {
  Component(ctrl, "Controlador REST de inscripciones", "Adaptador de entrada (Spring MVC)", "Expone inscribir, cancelar y consultar estado. Autentica al estudiante con el token y exige el encabezado Idempotency-Key.")
  Component(idem, "Guardia de idempotencia", "Servicio de aplicación", "Registra la clave de idempotencia en la misma transacción; si ya existe, devuelve la respuesta almacenada sin reejecutar.")
  Component(ucIns, "Caso de uso Inscribir asignatura", "Servicio de aplicación (límite transaccional)", "Orquesta en UNA transacción: bloqueo por estudiante, reglas, cupo, inscripción, outbox y auditoría.")
  Component(ucCan, "Caso de uso Cancelar inscripción", "Servicio de aplicación (límite transaccional)", "Valida fechas, cambia el estado, libera el cupo y registra outbox y auditoría.")
  Component(ucRes, "Caso de uso Aplicar resultado de sincronización", "Servicio de aplicación (límite transaccional)", "Transiciona a CONFIRMADA o RECHAZADA; en rechazo libera el cupo (compensación).")
  Component(qry, "Consulta de estado", "Servicio de consulta (solo lectura)", "Lista las inscripciones del estudiante con su estado y el estado actual del legado.")
  Component(dom, "Agregado Inscripción", "Modelo de dominio", "Máquina de estados de la inscripción e invariantes: una inscripción activa por estudiante, asignatura y período.")
  Component(cupos, "Control de cupos", "Puerto + adaptador SQL", "Descuenta el cupo con una actualización condicional atómica; libera cupos en cancelaciones y rechazos.")
  Component(repo, "Repositorio de inscripciones", "Puerto + adaptador JPA", "Persiste el agregado. Restricción de unicidad parcial sobre inscripciones activas.")
  Component(outbox, "Publicador de eventos de integración", "Puerto + adaptador SQL", "Inserta InscripcionRegistrada / InscripcionCancelada en integracion.outbox en la misma transacción.")
}

Component(reglas, "Módulo Reglas académicas", "Interfaz pública del módulo", "Evalúa prerrequisitos, conflicto de horario, límite de créditos y fechas del período.")
Component(hist, "Módulo Historial académico", "Interfaz pública del módulo", "Copia local del historial importada del legado, con marca de vigencia por estudiante.")
Component(oferta, "Módulo Oferta académica", "Interfaz pública del módulo", "Grupos, horarios y capacidad autorizada del período.")
Component(audit, "Módulo Auditoría", "Interfaz pública del módulo", "Registro de solo inserción: actor, operación, estado anterior y nuevo, fecha y origen.")

Rel(proxy, ctrl, "Solicitudes", "HTTP / JSON")
Rel(ctrl, idem, "Verifica / registra la clave")
Rel(ctrl, ucIns, "Inscribir")
Rel(ctrl, ucCan, "Cancelar")
Rel(ctrl, qry, "Consultar estado")
Rel(ucIns, reglas, "Valida reglas")
Rel(reglas, hist, "Lee historial vigente")
Rel(reglas, oferta, "Lee horarios y créditos")
Rel(ucIns, cupos, "Descuenta cupo")
Rel(ucIns, dom, "Crea inscripción")
Rel(ucIns, repo, "Guarda")
Rel(ucIns, outbox, "Publica evento")
Rel(ucIns, audit, "Registra operación")
Rel(ucCan, cupos, "Libera cupo")
Rel(ucCan, repo, "Actualiza")
Rel(ucCan, outbox, "Publica evento")
Rel(ucCan, audit, "Registra operación")
Rel(sync, ucRes, "Entrega resultado del legado", "Invocación en proceso (misma base de código)")
Rel(ucRes, repo, "Actualiza estado")
Rel(ucRes, cupos, "Libera cupo si hay rechazo")
Rel(ucRes, audit, "Registra operación")
Rel(cupos, db, "UPDATE condicional", "SQL")
Rel(repo, db, "Lee / escribe", "SQL")
Rel(outbox, db, "INSERT outbox", "SQL")
Rel(qry, db, "Lee", "SQL")

SHOW_LEGEND()
@enduml
